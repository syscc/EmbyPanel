emby_host = "http://localhost:8096"
emby_api_key = "your_emby_api_key"
port = 18096
cache_ttl_seconds = 180
enable_internal_redirect = false
internal_redirect_timeout_seconds = 15
strm_url_mappings = """
# 每行一个映射：原地址 => 新地址
https://source.example.com => http://media-gateway.local:5244
# 高级正则格式：regex:https://source\\.(example|test)\\.com => http://media-gateway.local:5244
"""

# Optional. Only needed when Emby media paths are OpenList /d/... URLs and
# must be resolved through OpenList /api/fs/get.
# openlist_addr = "http://localhost:5244"
# openlist_token = "your_openlist_token"
